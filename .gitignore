# Freebuff's own project metadata (audit snapshots, project id) — local, not app
.freebuff/

# Vercel's local link, and the token file `vercel link` writes beside it
.vercel
.env*

# Python bytecode from the tools/ scripts
__pycache__/
*.pyc

# Supabase working files: the CLI token, the desk-admin credentials the
# verification writes, the migration pusher and the cleanup scripts. All of it
# is gitignored inside supabase/ too, but ignore it here as well so no amount
# of `git add` carelessness can ever pick the token up.
supabase/.temp/

# OS noise
.DS_Store
Thumbs.db
nul

# The local dev server's own log and pid, started by the tooling that serves
# the app over http — nothing to do with the app itself.
.server.log
.server.pid
